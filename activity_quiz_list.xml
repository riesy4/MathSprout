<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <Button
        android:id="@+id/quizEasyBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Easy Quiz"
        android:backgroundTint="@color/primary_color"
        android:textColor="@android:color/white"/>

    <Button
        android:id="@+id/quizMediumBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Medium Quiz"
        android:backgroundTint="@color/primary_color"
        android:textColor="@android:color/white"
        android:layout_below="@id/quizEasyBtn" />

    <Button
        android:id="@+id/quizHardBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Hard Quiz"
        android:backgroundTint="@color/primary_color"
        android:textColor="@android:color/white"
        android:layout_below="@id/quizMediumBtn" />

</RelativeLayout>
